#!/bin/bash
# First boot of the demo node: k3s, Helm, the AWS CLI and cert-manager. Runs once.
# Log: /var/log/lotse-bootstrap.log
set -euxo pipefail
exec > >(tee -a /var/log/lotse-bootstrap.log) 2>&1

snap install aws-cli --classic
snap install helm --classic

curl -sfL https://get.k3s.io | INSTALL_K3S_CHANNEL="${k3s_channel}" sh -s - server \
  --write-kubeconfig-mode 600 \
  --secrets-encryption

# k3s applies every manifest in this directory and keeps retrying until it succeeds.
cat > /var/lib/rancher/k3s/server/manifests/cert-manager.yaml <<'YAML'
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: cert-manager
  namespace: kube-system
spec:
  repo: https://charts.jetstack.io
  chart: cert-manager
  targetNamespace: cert-manager
  createNamespace: true
  valuesContent: |-
    crds:
      enabled: true
YAML

# Applied by the release script once cert-manager's CRDs exist.
mkdir -p /opt/lotse
cat > /opt/lotse/cluster-issuer.yaml <<'YAML'
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt
spec:
  acme:
    server: https://acme-v02.api.letsencrypt.org/directory
    privateKeySecretRef:
      name: letsencrypt-account-key
    solvers:
      - http01:
          ingress:
            ingressClassName: traefik
YAML
