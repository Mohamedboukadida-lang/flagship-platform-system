# Local development only. These values are public; never reuse them anywhere else.
# Passwords must be URL-safe (letters, digits, underscore) because they go into URLs.

# docker compose
POSTGRES_PASSWORD=postgres_dev
LOTSE_APP_DB_PASSWORD=lotse_app_dev
LOTSE_PLATFORM_DB_PASSWORD=lotse_platform_dev
KEYCLOAK_DB_PASSWORD=keycloak_dev
KEYCLOAK_ADMIN_PASSWORD=admin_dev
LOTSE_DEMO_PASSWORD=demo_dev
LOTSE_CONSOLE_URL=http://localhost:5173

# API (settings.py, prefix LOTSE_)
LOTSE_ENV=dev
LOTSE_DATABASE_URL=postgresql+asyncpg://lotse_app:lotse_app_dev@localhost:5432/lotse
LOTSE_PLATFORM_DATABASE_URL=postgresql://lotse_platform:lotse_platform_dev@localhost:5432/lotse
LOTSE_MIGRATIONS_DATABASE_URL=postgresql+asyncpg://postgres:postgres_dev@localhost:5432/lotse
LOTSE_REDIS_URL=redis://localhost:6379/0
LOTSE_OIDC_ISSUER=http://localhost:8080/auth/realms/lotse
LOTSE_OIDC_JWKS_URL=http://localhost:8080/auth/realms/lotse/protocol/openid-connect/certs
LOTSE_OIDC_AUDIENCE=lotse-api
